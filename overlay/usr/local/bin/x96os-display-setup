#!/bin/sh
# X96 OS: cap the desktop at 1920x1080.
# On a 4K TV the Mali-450 would have to draw 4x the pixels and the whole desktop gets sluggish.
# Set X96OS_ALLOW_4K=1 in /etc/x96os/display.conf to disable this.
[ -f /etc/x96os/display.conf ] && . /etc/x96os/display.conf
[ "${X96OS_ALLOW_4K:-0}" = 1 ] && exit 0
command -v xrandr >/dev/null 2>&1 || exit 0

out=$(xrandr --query 2>/dev/null | awk '/ connected/{print $1; exit}')
[ -n "$out" ] || exit 0
cur=$(xrandr --query 2>/dev/null | awk '/\*/{print $1; exit}')
w=${cur%%x*}
case "$w" in ''|*[!0-9]*) exit 0 ;; esac

if [ "$w" -gt 1920 ]; then
  if xrandr --query | grep -qE '^ +1920x1080 .*60\.00'; then
    xrandr --output "$out" --mode 1920x1080 --rate 60 2>/dev/null && exit 0
  fi
  xrandr --output "$out" --mode 1920x1080 2>/dev/null || true
fi
exit 0
