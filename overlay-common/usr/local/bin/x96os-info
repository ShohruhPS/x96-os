#!/bin/sh
# X96 OS system greeting: logo + live system info. Plain sh, reads /proc and /sys only (fast).
[ -r /etc/x96os-release ] && . /etc/x96os-release
EDITION=$(cat /etc/x96os/edition 2>/dev/null || echo desktop)

if { [ -t 1 ] || [ "${X96OS_COLOR:-0}" = 1 ]; } && [ "${NO_COLOR:-}" = "" ]; then
  R=$(printf '\033[0m'); B=$(printf '\033[1m'); D=$(printf '\033[2m')
  c() { printf '\033[38;5;%sm' "$1"; }
else
  R=""; B=""; D=""
  c() { :; }
fi

# ---- logo (block letters need a UTF-8 terminal; fall back to plain ASCII) ----
case "${LANG:-}${LC_ALL:-}" in
  *UTF-8*|*utf8*)
    set -- 99 135 171 207 211 215
    i=0
    while IFS= read -r line; do
      i=$((i+1)); eval col=\${$i}
      printf '  %s%s%s\n' "$(c "$col")" "$line" "$R"
    done <<'EOF'
██╗  ██╗ █████╗  ██████╗      ██████╗ ███████╗
╚██╗██╔╝██╔══██╗██╔════╝     ██╔═══██╗██╔════╝
 ╚███╔╝ ╚██████║███████╗     ██║   ██║███████╗
 ██╔██╗  ╚═══██║██╔═══██╗    ██║   ██║╚════██║
██╔╝ ██╗ █████╔╝╚██████╔╝    ╚██████╔╝███████║
╚═╝  ╚═╝ ╚════╝  ╚═════╝      ╚═════╝ ╚══════╝
EOF
    SEP="────────────────────────────────────────────────"; DOT="·"; MUL="×"; DEG="°C" ;;
  *)
    printf '%s' "$(c 171)"
    cat <<'EOF'
  __  _____   __      ___  ____
  \ \/ / _ \ / /_    / _ \/ ___|
   \  / (_) | '_ \  | | | \___ \
   /  \\__, | (_) | | |_| |___) |
  /_/\_\ /_/ \___/   \___/|____/
EOF
    printf '%s' "$R"
    SEP="------------------------------------------------"; DOT="-"; MUL="x"; DEG="C" ;;
esac

# ---- facts ----
deb=$(cat /etc/debian_version 2>/dev/null)
kern=$(uname -r)
cores=$(grep -c ^processor /proc/cpuinfo)
cur=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)
max=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null)
gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
t=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
cpu="${cores} ${MUL} Cortex-A53"
[ -n "$cur" ] && cpu="$cpu $DOT $((cur/1000))/$((max/1000)) MHz"
[ -n "$gov" ] && cpu="$cpu ($gov)"
if [ -n "$t" ]; then
  tc=$((t/1000)); tcol=114; [ "$tc" -ge 60 ] && tcol=221; [ "$tc" -ge 75 ] && tcol=203
  cpu="$cpu $DOT $(c $tcol)${tc}${DEG}$R"
fi

mem=$(awk -v dot="$DOT" '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} /^SwapTotal/{st=$2} /^SwapFree/{sf=$2}
  END{printf "%d MiB / %.1f GiB used", (t-a)/1024, t/1048576;
      if (st>0) printf " %s zram swap %d / %d MiB", dot, (st-sf)/1024, st/1024}' /proc/meminfo)
disk=$(df -h / 2>/dev/null | awk 'NR==2{printf "%s / %s used (%s)", $3, $2, $5}')
net=$(ip -4 -o addr show scope global 2>/dev/null | awk -v dot="$DOT" '{split($4,a,"/"); printf "%s%s %s", sep, $2, a[1]; sep="  " dot "  "}')
[ -n "$net" ] || net="not connected  (run: x96os wifi)"
up=$(awk '{s=int($1); d=int(s/86400); h=int(s%86400/3600); m=int(s%3600/60);
  if (d>0) printf "%dd %dh %dm", d, h, m; else if (h>0) printf "%dh %dm", h, m; else printf "%dm", m}' /proc/uptime)
load=$(cut -d' ' -f1-3 /proc/loadavg)

label() { printf '  %s%-9s%s %s\n' "$(c 141)$B" "$1" "$R" "$2"; }
echo
printf '  %sX96 OS %s%s %s %s edition %s Debian %s %s kernel %s\n' "$B" "${X96OS_VERSION:-}" "$R" "$DOT" "$EDITION" "$DOT" "$deb" "$DOT" "$kern"
printf '  %s%s%s\n' "$D" "$SEP" "$R"
label CPU "$cpu"
label Memory "$mem"
label Storage "$disk"
label Network "$net"
label Uptime "$up $DOT load $load"
echo
printf '  %sx96os help%s  %s  %sx96os wifi%s  %s  %sx96os install%s\n\n' "$(c 213)" "$R" "$DOT" "$(c 213)" "$R" "$DOT" "$(c 213)" "$R"
